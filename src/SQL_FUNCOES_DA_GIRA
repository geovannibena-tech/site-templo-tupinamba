-- SITE PÚBLICO: permitir leitura anônima somente do conteúdo marcado como público.
-- Execute no SQL Editor do Supabase uma única vez.

grant usage on schema public to anon;
grant select on table public.giras to anon;
grant select on table public.avisos to anon;

drop policy if exists "publico_ler_giras_abertas" on public.giras;
create policy "publico_ler_giras_abertas"
on public.giras
for select
to anon
using (aberta_publico = true);

drop policy if exists "publico_ler_avisos_publicados" on public.avisos;
create policy "publico_ler_avisos_publicados"
on public.avisos
for select
to anon
using (
  publicado = true
  and (
    publico is null
    or lower(publico) in ('todos', 'publico', 'público')
  )
);
