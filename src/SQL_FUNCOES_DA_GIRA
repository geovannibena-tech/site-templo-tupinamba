-- PACOTE FINAL - FUNÇÕES DA GIRA
-- Rode este SQL UMA VEZ no Supabase > SQL Editor > New query > Run.

create table if not exists public.funcoes_gira (
  id bigint generated by default as identity primary key,
  gira_id bigint not null references public.giras(id) on delete cascade,
  filho_id uuid not null references public.perfis(id) on delete cascade,
  funcao text not null,
  observacoes text,
  criado_em timestamptz not null default now(),
  unique (gira_id, filho_id)
);

alter table public.funcoes_gira enable row level security;

drop policy if exists "filho_le_propria_funcao" on public.funcoes_gira;
create policy "filho_le_propria_funcao"
on public.funcoes_gira
for select
to authenticated
using (
  filho_id = auth.uid()
  or public.eh_admin()
);

drop policy if exists "admin_insere_funcao" on public.funcoes_gira;
create policy "admin_insere_funcao"
on public.funcoes_gira
for insert
to authenticated
with check (public.eh_admin());

drop policy if exists "admin_atualiza_funcao" on public.funcoes_gira;
create policy "admin_atualiza_funcao"
on public.funcoes_gira
for update
to authenticated
using (public.eh_admin())
with check (public.eh_admin());

drop policy if exists "admin_exclui_funcao" on public.funcoes_gira;
create policy "admin_exclui_funcao"
on public.funcoes_gira
for delete
to authenticated
using (public.eh_admin());

create or replace function public.admin_listar_funcoes_gira()
returns table (
  id bigint,
  gira_id bigint,
  filho_id uuid,
  funcao text,
  observacoes text,
  criado_em timestamptz,
  nome text,
  gira_titulo text,
  data_gira date
)
language sql
security definer
set search_path = public
as $$
  select
    fg.id,
    fg.gira_id,
    fg.filho_id,
    fg.funcao,
    fg.observacoes,
    fg.criado_em,
    p.nome,
    g.titulo as gira_titulo,
    g.data_gira
  from public.funcoes_gira fg
  join public.perfis p on p.id = fg.filho_id
  join public.giras g on g.id = fg.gira_id
  where public.eh_admin()
  order by g.data_gira desc, p.nome;
$$;

grant execute on function public.admin_listar_funcoes_gira() to authenticated;
